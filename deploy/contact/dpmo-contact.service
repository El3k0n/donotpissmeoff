# DPMO! contact relay. Installed as /etc/systemd/system/dpmo-contact.service by deploy/contact/install.sh.
[Unit]
Description=DPMO! contact form relay (donotpissmeoff.com -> OpenBot Vex)
After=network-online.target nordvpnd.service
Wants=network-online.target

[Service]
Type=simple
User=dpmo-contact
Group=dpmo-contact
# DPMO_WEBHOOK_URL=... (written by deploy/contact/set-webhook.sh)
EnvironmentFile=-/etc/dpmo-contact/env
# Root-only file; systemd hands the service a private copy. Empty = queue only.
LoadCredential=webhook-secret:/etc/dpmo-contact/webhook-secret
ExecStart=/usr/bin/python3 -I /opt/dpmo-contact/contact_relay.py
StateDirectory=dpmo-contact
StateDirectoryMode=0700
UMask=0077
Restart=always
RestartSec=5

NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
MemoryMax=128M

[Install]
WantedBy=multi-user.target
